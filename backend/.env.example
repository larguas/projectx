# Copier ce fichier en `.env` (jamais commité) et adapter les valeurs.

# --- Django -------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
SECRET_KEY=tu-changes-moi-en-prod
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées en production (séparées par des virgules).
CSRF_TRUSTED_ORIGINS=

# --- Base de données (PostgreSQL) ----------------------------------------
DATABASE_URL=postgres://emg:emg@localhost:5432/emg

# --- Redis (health check, cache, Celery) ----------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Observabilité ---------------------------------------------------------
LOG_LEVEL=INFO
# Laisser vide pour désactiver Sentry (dev / tests).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- API --------------------------------------------------------------------
DEFAULT_PAGE_SIZE=50
# Origines CORS autorisées (frontend Vite par défaut en dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173
