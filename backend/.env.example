# Copier ce fichier en `.env` (jamais commité) et adapter les valeurs.

# --- Django -------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
SECRET_KEY=tu-changes-moi-en-prod
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées en production (séparées par des virgules).
CSRF_TRUSTED_ORIGINS=

# --- Base de données (PostgreSQL) ----------------------------------------
DATABASE_URL=postgres://emg:emg@localhost:5432/emg

# --- Redis (health check, cache, Celery) ----------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Observabilité ---------------------------------------------------------
LOG_LEVEL=INFO
# Laisser vide pour désactiver Sentry (dev / tests).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- API --------------------------------------------------------------------
DEFAULT_PAGE_SIZE=50
# Origines CORS autorisées (frontend Vite par défaut en dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT (feature 02) ----------------------------------------------------------
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
# Durée de validité du lien de réinitialisation de mot de passe (secondes).
PASSWORD_RESET_TIMEOUT_SECONDS=3600

# --- Throttling (scopes DRF, feature 02) -----------------------------------------
THROTTLE_LOGIN=10/min
THROTTLE_PASSWORD_RESET=5/min
THROTTLE_EMAIL_RESEND=3/min
THROTTLE_DEVICE_CODE=5/min
THROTTLE_DEVICE_APPROVE=10/min

# --- Email (feature 02) ----------------------------------------------------------
# En dev : backend console (les emails s'affichent dans le terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@emg.local
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# URL de l'application web (liens des emails et du flux device code).
FRONTEND_URL=http://localhost:5173
